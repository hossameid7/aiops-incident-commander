GROQ_API_KEY=gsk_your_groq_api_key_here
TELEGRAM_BOT_TOKEN=your_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
LOG_LEVEL=INFO

# FastAPI Server Configuration
API_HOST=0.0.0.0
API_PORT=8000

# Telegram Configuration
# Obtain by messaging your bot with /start and checking the getUpdates endpoint
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# ChromaDB Configuration
CHROMA_PERSIST_DIR=./chroma_db
CHROMA_COLLECTION_NAME=runbooks

# Remediation Configuration
# Set to false to enable real command execution (CAUTION: use only in controlled environments)
DRY_RUN=true
ANSIBLE_PLAYBOOK_DIR=./playbooks
